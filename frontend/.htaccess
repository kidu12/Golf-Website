# Apache configuration for Golf Club Addis Frontend (React SPA)

# 1. Force HTTPS & Routing
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Return genuine 404 for missing source maps and static files (do NOT fallback to index.html)
  RewriteCond %{REQUEST_URI} \.(map|ico|png|jpe?g|gif|svg|woff2?|ttf|eot)$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]

  # Redirect HTTP to HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect www to non-www
  RewriteCond %{HTTP_HOST} ^www\.golfclubaddis\.com [NC]
  RewriteRule ^(.*)$ https://golfclubaddis.com/$1 [L,R=301]

  # Block access to hidden files and directories (.env, .git, etc.)
  RewriteRule "(^|/)\.(?!well-known)" - [F]

  # React SPA HTML5 client-side routing
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# 2. Disable directory browsing
Options -Indexes

# 3. Security Headers
<IfModule mod_headers.c>
  # HTTP Strict Transport Security (HSTS)
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Prevent MIME-type sniffing
  Header set X-Content-Type-Options "nosniff"

  # Prevent Clickjacking
  Header set X-Frame-Options "DENY"

  # Referrer Policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions Policy
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Deny all access to source maps
  <FilesMatch "\.map$">
    <IfModule !mod_authz_core.c>
      Order Allow,Deny
      Deny from all
    </IfModule>
    <IfModule mod_authz_core.c>
      Require all denied
    </IfModule>
  </FilesMatch>
</IfModule>

# 4. Deny access to sensitive files
<FilesMatch "(?i)\.(env|config|bak|old|sql|tar|gz|zip|git.*)$">
  <IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
  </IfModule>
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
